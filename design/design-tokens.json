{
  "$schemaComment": "Wingman design tokens — Semantic Color Contract.",
  "brand": {
    "name": "Wingman",
    "principle": "Semantic Color Contract"
  },
  "semanticColorContract": {
    "rule": "A color never represents an action; it always represents a state. Actions are carried by shape, hierarchy, or animation.",
    "implications": [
      "Green is never a Validate button — only Available.",
      "Blue is never the primary button — only Interaction (signal sent/received).",
      "Violet is never decoration — only Mutual Match.",
      "Orange is never a graphic accent — only Active Mission.",
      "Turquoise is never a user state — only Wingman system (radar, GPS, scan, AI).",
      "Red is only Unavailable, danger, or critical error — never notifications or CTAs."
    ]
  },
  "surfaces": {
    "bgPrimary": "#0B1020",
    "bgSecondary": "#101522",
    "bgRadar": "#0B1020",
    "card": "#171F35",
    "elevated": "#1D2740",
    "border": "rgba(255,255,255,.05)",
    "cta": "#F7F8FC",
    "ctaText": "#0B1020"
  },
  "text": {
    "primary": "#FFFFFF",
    "secondary": "#AAB2C8",
    "muted": "#6B7280",
    "disabled": "#4B5563"
  },
  "system": {
    "turquoise": "#22D3EE",
    "glow": "rgba(34,211,238,.28)",
    "meaning": "Wingman system only: radar, GPS, position, scan, AI, search",
    "never": "user presence states"
  },
  "states": {
    "available": {
      "color": "#10B981",
      "glow": "rgba(16,185,129,.25)",
      "shape": "circle",
      "glyph": "●",
      "meaning": "Open to interactions"
    },
    "busy": {
      "color": "#F59E0B",
      "glow": "rgba(245,158,11,.25)",
      "shape": "triangle",
      "glyph": "▲",
      "meaning": "Momentarily busy — not do-not-disturb"
    },
    "unavailable": {
      "color": "#EF4444",
      "glow": "rgba(239,68,68,.25)",
      "shape": "square",
      "glyph": "■",
      "meaning": "Do not disturb — also danger / critical error only"
    },
    "signalSent": {
      "color": "#3B82F6",
      "glow": "rgba(59,130,246,.30)",
      "shape": "filled-ring-dot",
      "glyph": "◉",
      "fill": "solid",
      "meaning": "You sent a signal"
    },
    "signalReceived": {
      "color": "#3B82F6",
      "glow": "rgba(59,130,246,.30)",
      "shape": "outline-ring",
      "glyph": "◎",
      "fill": "outline",
      "meaning": "Someone sent you a signal"
    },
    "match": {
      "color": "#8B5CF6",
      "glow": "rgba(139,92,246,.30)",
      "shape": "diamond",
      "glyph": "◆",
      "meaning": "Mutual validated connection — exclusive visual reward",
      "exclusivity": "Appear only when both parties are officially connected"
    },
    "mission": {
      "color": "#FB923C",
      "glow": "rgba(251,146,60,.28)",
      "shape": "hexagon",
      "glyph": "⬢",
      "meaning": "Active meetup",
      "animation": {
        "type": "breath",
        "from": 1,
        "to": 0.96,
        "durationMs": 3000,
        "note": "Slow respiration — never blink"
      }
    },
    "invisible": {
      "color": "#6B7280",
      "shape": "empty-circle",
      "glyph": "○",
      "meaning": "Off radar"
    },
    "offline": {
      "color": "#374151",
      "shape": "cross",
      "glyph": "✕",
      "meaning": "Disconnected"
    }
  },
  "notifications": {
    "signals": "#3B82F6",
    "match": "#8B5CF6",
    "mission": "#FB923C",
    "never": "red"
  },
  "intensity": {
    "availableFull": 1,
    "availableLong": 0.8,
    "availableLeaving": 0.6,
    "note": "One Available green; freshness via opacity only."
  },
  "avoid": [
    "State colors on CTAs or Validate buttons",
    "Violet anywhere except mutual match",
    "Red for notifications, badges, or CTAs",
    "Multiple greens without meaning",
    "Turquoise for human presence",
    "Rainbow decorative effects"
  ]
}
