    "@wingman/contracts": "workspace:*",
    "@wingman/domain": "workspace:*",
    "@wingman/ephemeral": "workspace:*",
    "@wingman/notifications": "workspace:*",
    "@wingman/observability": "workspace:*",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
